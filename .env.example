# Copy this file to .env (local dev) and to Vercel's Environment Variables (production).

# ── Database (Neon Postgres) ────────────────────────────────────────────────
# Get both from your Neon project dashboard → Connection Details.
# DATABASE_URL: the *pooled* connection (hostname has "-pooler") — used by the
#   app at runtime; required for serverless (Vercel functions) to avoid
#   exhausting Postgres connections.
# DIRECT_URL: the *unpooled* connection — used only by `prisma migrate`, which
#   needs a direct connection for advisory locks/schema introspection that
#   PgBouncer-style poolers don't support reliably.
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/healthcare?sslmode=require"
DIRECT_URL="postgresql://user:password@host.neon.tech/healthcare?sslmode=require"

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
# Local dev: http://localhost:3000  |  Prod: your Vercel URL
NEXTAUTH_URL="http://localhost:3000"

# ── LLM (Anthropic Claude) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
# Must be a verified sender/domain in your Resend account.
EMAIL_FROM="CareFlow <onboarding@resend.dev>"

# ── Google Calendar (OAuth 2.0) ──────────────────────────────────────────────
# Create credentials in Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI: <NEXTAUTH_URL>/api/google/callback
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxx"

# ── Admin bootstrap (used only by `npx prisma db seed`) ─────────────────────
ADMIN_EMAIL="admin@clinic.test"
ADMIN_PASSWORD="ChangeMe123!"

# ── Background jobs (Vercel Cron) ────────────────────────────────────────────
# Shared secret checked by cron API routes so they can't be triggered by anyone
# who guesses the URL. Vercel Cron sends this as a Bearer token automatically
# when set as CRON_SECRET in Vercel's env vars.
CRON_SECRET="replace-with-a-random-secret"
